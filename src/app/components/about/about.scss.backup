.about {
  padding: 5rem 0;
  background: linear-gradient(
    180deg,
    #0f172a 0%,           /* Navy oscuro del hero */
    #1e293b 25%,          /* Navy medio */
    #334155 50%,          /* Slate medio */
 /* Imagen placeholder más impactante */
.image-container {
  background-image: 
    linear-gradient(
      135deg, 
      rgba(15, 23, 42, 0.8), 
      rgba(30, 41, 59, 0.6)
    ),
    url('https://images.unsplash.com/photo-1551650975-87deedd944c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.1) 0%,
      rgba(244, 208, 63, 0.05) 100%
    );
    z-index: 1;
  }
  
  // Overlay con efecto de código
  &::after {
    content: '{ "role": "Full Stack Developer", "passion": "Backend Architecture", "focus": "Innovation" }';
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    padding: 1rem;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 10px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #d4af37;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    line-height: 1.4;
    z-index: 2;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
  }
  
  &:hover::after {
    opacity: 1;
    transform: translateY(0);
  }
}748b 75%,          /* Slate claro */
    #f8fafc 100%          /* Casi blanco */
  );
  position: relative;
  
  // Efecto de glassmorphism sutil
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(1px);
    pointer-events: none;
  }
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-title {
  font-size: 2.5rem;
  text-align: center;
  margin-bottom: 3rem;
  color: #f1f5f9; /* Texto claro para contrastar con el fondo oscuro superior */
  font-weight: 700;
  position: relative;
  z-index: 1;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.section-title::after {
  content: '';
  width: 60px;
  height: 4px;
  background: linear-gradient(135deg, #d4af37, #f4d03f); /* Dorado ejecutivo */
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 2px 8px rgba(212, 175, 55, 0.4);
}

.about-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.about-text {
  animation: fadeInLeft 1s ease-out;
  position: relative;
  z-index: 1;
  
  // Sutil contenedor glassmorphism para mejor legibilidad
  padding: 2rem;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  
  // Botón ejecutivo
  .btn {
    padding: 16px 32px;
    background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
    color: #0f172a;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-block;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    
    &:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5);
      background: linear-gradient(135deg, #f4d03f 0%, #d4af37 100%);
    }
    
    &:active {
      transform: translateY(-1px) scale(1.02);
    }
  }
}

.about-description {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #cbd5e1;
  margin-bottom: 2rem;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  z-index: 1;
  position: relative;
  text-align: justify; /* Texto justificado */
  text-justify: inter-word; /* Espaciado suave entre palabras */
  hyphens: auto; /* Separación silábica automática */
  font-weight: 400;
  letter-spacing: 0.3px; /* Espaciado sutil entre letras */
  
  /* Primera línea con sangría francesa elegante */
  &:first-of-type::first-line {
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  
  /* Efecto de fade-in por párrafo */
  &:nth-child(1) {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  
  &:nth-child(2) {
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin: 3rem 0;
}

.stat {
  text-align: center;
  padding: 1.5rem;
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.stat:hover {
  transform: translateY(-8px) scale(1.05);
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(212, 175, 55, 0.4);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.stat h3 {
  font-size: 2rem;
  color: #d4af37; /* Dorado ejecutivo */
  margin-bottom: 0.5rem;
  font-weight: 700;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.stat p {
  color: #e2e8f0; /* Gris muy claro */
  font-weight: 500;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.about-image {
  animation: fadeInRight 1s ease-out;
}

// Animaciones para el texto
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.image-container {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  
  &:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    border-color: rgba(212, 175, 55, 0.3);
  }
}

.about-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: none; /* Se mostrará cuando se añada la imagen */
}

/* Placeholder para imagen */
.image-container::before {
  content: '💻';
  font-size: 4rem;
  color: #ccc;
}

@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-50px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(50px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@media screen and (max-width: 768px) {
  .about-content {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .about-stats {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}
